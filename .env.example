# =============================================================================
# LTI 1.3 Moodle Integration — Environment Variables
# =============================================================================
# Copy this file to your backend's .env and fill in the values for your setup.
# Only LTI_ENABLED, LTI_ENCRYPTION_KEY, and LTI_DB_URL are strictly required.
# Everything else has sensible defaults.

# -----------------------------------------------------------------------------
# Core (REQUIRED)
# -----------------------------------------------------------------------------

# Master switch — set to true to enable the LTI module
LTI_ENABLED=true

# Symmetric encryption key used by ltijs to encrypt platform credentials at
# rest. Must be a stable random string (32 hex chars recommended).
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
LTI_ENCRYPTION_KEY=changeme_replace_with_32_hex_chars

# MongoDB connection string used by ltijs INTERNALLY for storing platform
# metadata, nonces, etc. Can be a dedicated DB or the same one as your app.
#
# Set this OR wire up a SQL plugin in code via `initLti({ dbPlugin })` — the
# plugin wins when both are present. The official community SQL plugin is
# `ltijs-sequelize` (Postgres / MySQL / MariaDB / MSSQL / SQLite). See the
# "SQL-backed deployments" section of README.md for the wiring snippet.
LTI_DB_URL=mongodb://localhost:27017/lti

# -----------------------------------------------------------------------------
# Login-only mode (SSO replacement)
# -----------------------------------------------------------------------------

# Skip every deep-linking surface (route + adapter call). When true, the LTI
# core does not register /deeplink/*, /launch/manage, /launch/manage/update,
# or /category/* — and never invokes adapter methods related to courses,
# resources, categories, bindings, or tenant grants. Use the minimal
# `LtiLoginOnlyAdapter` shape (see adapters/login-only.example.ts).
# Defaults to false. Can also be set programmatically via initLti's
# `skipDeepLinking: true` option, which takes precedence.
# LTI_SKIP_DEEP_LINKING=true

# When skipDeepLinking is enabled, this is the SPA route the launcher
# redirects to (your LtiLaunchView, which exchanges ltik for an app JWT).
# Set via the `loginOnlyLaunchPath` init option; no env var equivalent
# because it's path-only and your frontend controls it.

# Optional trusted institutional-ID provenance. No institutional identifier is
# trusted by default. Prefer a dedicated custom claim configured by the LMS:
# LTI_INSTITUTIONAL_ID_CUSTOM_CLAIM=institution_user_id
#
# Or explicitly trust the standard LIS person_sourcedid claim:
# LTI_INSTITUTIONAL_ID_SOURCE=lis_person_sourcedid

# Masked identity diagnostics (presence, length, numeric flag, short
# fingerprint). Does not print raw identity values:
# LTI_DEBUG_CLAIMS=true
#
# Emergency raw exchange diagnostics. Contains PII, but credentials are still
# redacted. Enable briefly and protect logs:
# LTI_DEBUG_RAW_CLAIMS=true

# -----------------------------------------------------------------------------
# Central broker consumer (OPTIONAL; separate from direct LTI)
# -----------------------------------------------------------------------------

# Public broker issuer/JWKS origin and this downstream App id/audience.
# The App record must allow-list the backend callback and use `course-based`
# when the callback needs signed Moodle course context.
# BROKER_BASE_URL=https://lti.talic.hku.hk
# BROKER_APP_ID=learnity

# -----------------------------------------------------------------------------
# Mount path & launch behaviour
# -----------------------------------------------------------------------------

# All LTI endpoints (login, launch, keys, deeplink, session, manage) will be
# mounted under this path. MUST be identical to ltiBase passed to
# configureLtiApi() on the frontend.
LTI_MOUNT_PATH=/api/v1/lti

# ltijs LTIaaS mode — bypasses browser third-party cookie restrictions by
# threading state through URL params instead. STRONGLY RECOMMENDED for
# production / iframe embedding.
LTI_LTIAAS_MODE=true

# Optional: where to send teachers AFTER they finish a normal launch
# (post Deep Linking). Supports {resourceId} and {courseId} placeholders.
# Leave unset to use the built-in teacher management page.
# LTI_TEACHER_LAUNCH_URL=https://app.example.com/teacher/resources/{resourceId}?course={courseId}

# Optional: change where students land after the session bridge.
# - "default" (default) → /lti/launch?agentId=...   (full SPA shell)
# - "embed"             → /embed/{resourceId}      (minimal shell, useful for widget mode)
# LTI_LAUNCH_DESTINATION=default

# Optional: auto-add students to a mapped course on first launch. Default: true.
# LTI_AUTO_ENROLL_STUDENTS=true

# -----------------------------------------------------------------------------
# LTI 1.0a / 1.1 (legacy, OAuth 1.0a) support — OPTIONAL, default OFF
# -----------------------------------------------------------------------------
# Enables being launched from older LMSs that speak LTI 1.0a / 1.1 (an OAuth
# 1.0a HMAC-SHA1-signed form POST with a shared consumer key/secret — no OIDC,
# no JWT). The 1.3 path is unaffected. Requires a `consumerStore` (resolves the
# shared secret by consumer key) passed to initLti, plus a signing secret
# (LTI_LAUNCH_TICKET_SECRET or the bind-token secret) for the session bridge.
# LTI_LEGACY_ENABLED=true

# Subpath (under LTI_MOUNT_PATH) where the legacy router mounts. The launch URL
# given to the old LMS is `${APP_URL}${LTI_MOUNT_PATH}${LTI_LEGACY_MOUNT}/launch`.
# Defaults to /legacy.
# LTI_LEGACY_MOUNT=/legacy

# OAuth 1.0a timestamp acceptance window in seconds (default 300).
# LTI_LEGACY_TIMESTAMP_WINDOW_S=300

# In-memory nonce retention in ms for replay protection (default 600000).
# Supply your own shared nonceStore for multi-instance deployments.
# LTI_LEGACY_NONCE_TTL_MS=600000

# Enable LTI 1.1 Content-Item deep linking (teacher picks content; the tool
# signs a return form back to the LMS). Default OFF.
# LTI_LEGACY_DEEP_LINKING=true

# Secret used to sign the short-lived launch ticket the 1.1 SPA exchanges at the
# legacy /session endpoint. Falls back to the bind-token secret if unset.
# LTI_LAUNCH_TICKET_SECRET=replace_with_long_random_string

# -----------------------------------------------------------------------------
# LTI 1.3 Assignment & Grade Services (AGS) — EXPERIMENTAL prototype, default OFF
# -----------------------------------------------------------------------------
# Enables the experimental 1.3 AGS score-passback prototype (built on ltijs's
# Grade service). Off by default; the 1.3 path's behaviour is unchanged unless
# enabled. Not production-hardened — see README/CHANGELOG.
# LTI_AGS_PROTOTYPE=true

# -----------------------------------------------------------------------------
# Default Platform Registration (OPTIONAL)
# -----------------------------------------------------------------------------
# If all 5 core vars (URL, CLIENT_ID, AUTH_ENDPOINT, TOKEN_ENDPOINT,
# KEYSET_URL) are set, that ONE platform is auto-registered on backend boot.
# Set none of them and register platforms via the admin UI
# (LtiPlatformsAdmin.vue) or POST /api/v1/lti/platforms instead — that path is
# also the only way to register MORE THAN ONE platform, or to use the JWK_KEY /
# RSA_KEY auth methods (env auto-registration always uses JWK_SET + a keyset URL).
#
# Pick ONE of the LMS blocks below, uncomment it, and fill in CLIENT_ID (the
# LMS generates that when you create the External Tool / LTI Advantage app).
# The endpoint paths shown are the documented defaults for each LMS; exact
# hosts/paths can vary by version, region, and self-hosted vs. cloud — always
# confirm against the values shown on your LMS's own LTI registration screen.
#
# Field meaning (same five fields for every LMS):
#   LTI_PLATFORM_URL          → the platform ISSUER (`iss`) — NOT always the
#                               browser host; some clouds use a fixed issuer.
#   LTI_PLATFORM_CLIENT_ID    → OAuth2 client id the LMS assigned to this tool.
#   LTI_PLATFORM_AUTH_ENDPOINT→ OIDC authorization / login redirect URL.
#   LTI_PLATFORM_TOKEN_ENDPOINT→ OAuth2 access-token URL (for services/AGS).
#   LTI_PLATFORM_KEYSET_URL   → the LMS's public JWKS (key set) URL.

# Common
# LTI_PLATFORM_CLIENT_ID=
# Optional: friendly name shown in the admin UI (defaults to "Moodle")
# LTI_PLATFORM_NAME=My LMS
# Optional: explicit Authentication Server URL (defaults to LTI_PLATFORM_URL)
# LTI_PLATFORM_AUTH_SERVER=https://lms.example.com

# --- Moodle (self-hosted or MoodleCloud) ------------------------------------
# Issuer = your Moodle base URL (no trailing slash).
# LTI_PLATFORM_NAME=Moodle
# LTI_PLATFORM_URL=https://moodle.example.com
# LTI_PLATFORM_AUTH_ENDPOINT=https://moodle.example.com/mod/lti/auth.php
# LTI_PLATFORM_TOKEN_ENDPOINT=https://moodle.example.com/mod/lti/token.php
# LTI_PLATFORM_KEYSET_URL=https://moodle.example.com/mod/lti/certs.php

# --- Canvas (Instructure-hosted, production) --------------------------------
# Cloud Canvas uses a FIXED canonical issuer + shared SSO host for all
# institutions — do NOT use your <school>.instructure.com host as the issuer.
# (Beta/Test regions use canvas.beta./canvas.test. + sso.beta./sso.test.)
# LTI_PLATFORM_NAME=Canvas
# LTI_PLATFORM_URL=https://canvas.instructure.com
# LTI_PLATFORM_AUTH_ENDPOINT=https://sso.canvaslms.com/api/lti/authorize_redirect
# LTI_PLATFORM_TOKEN_ENDPOINT=https://sso.canvaslms.com/login/oauth2/token
# LTI_PLATFORM_KEYSET_URL=https://sso.canvaslms.com/api/lti/security/jwks

# --- Canvas (open-source / self-hosted) -------------------------------------
# Self-hosted Canvas uses your own host for every URL, issuer included.
# LTI_PLATFORM_NAME=Canvas
# LTI_PLATFORM_URL=https://canvas.example.com
# LTI_PLATFORM_AUTH_ENDPOINT=https://canvas.example.com/api/lti/authorize_redirect
# LTI_PLATFORM_TOKEN_ENDPOINT=https://canvas.example.com/login/oauth2/token
# LTI_PLATFORM_KEYSET_URL=https://canvas.example.com/api/lti/security/jwks

# --- Blackboard Learn (SaaS, Anthology) -------------------------------------
# SaaS Blackboard uses a single global issuer + shared developer gateway for
# auth/token; the JWKS lives under your registered application id.
# LTI_PLATFORM_NAME=Blackboard Learn
# LTI_PLATFORM_URL=https://blackboard.com
# LTI_PLATFORM_AUTH_ENDPOINT=https://developer.blackboard.com/api/v1/gateway/oidcauth
# LTI_PLATFORM_TOKEN_ENDPOINT=https://developer.blackboard.com/api/v1/gateway/oauth2/jwttoken
# LTI_PLATFORM_KEYSET_URL=https://developer.blackboard.com/api/v1/management/applications/<applicationId>/jwks.json

# --- D2L Brightspace --------------------------------------------------------
# Issuer + OIDC auth + JWKS are on your tenant host; the access-token endpoint
# is D2L's central auth service (same for every tenant).
# LTI_PLATFORM_NAME=Brightspace
# LTI_PLATFORM_URL=https://brightspace.example.com
# LTI_PLATFORM_AUTH_ENDPOINT=https://brightspace.example.com/d2l/lti/authenticate
# LTI_PLATFORM_TOKEN_ENDPOINT=https://auth.brightspace.com/core/connect/token
# LTI_PLATFORM_KEYSET_URL=https://brightspace.example.com/d2l/.well-known/jwks

# --- Sakai ------------------------------------------------------------------
# Token/keyset paths are suffixed with the LMS-side tool id Sakai shows you on
# the LTI 1.3 registration page (shown here as <toolId>).
# LTI_PLATFORM_NAME=Sakai
# LTI_PLATFORM_URL=https://sakai.example.com
# LTI_PLATFORM_AUTH_ENDPOINT=https://sakai.example.com/imsoidc/lti13/oidc_auth
# LTI_PLATFORM_TOKEN_ENDPOINT=https://sakai.example.com/imsblis/lti13/token/<toolId>
# LTI_PLATFORM_KEYSET_URL=https://sakai.example.com/imsblis/lti13/keyset/<toolId>

# --- Any other LTI 1.3 platform (generic template) --------------------------
# Any spec-conformant LMS works; copy the four URLs from its tool-registration
# screen verbatim. If it publishes an OpenID config, the four values map to:
#   issuer → URL, authorization_endpoint → AUTH, token_endpoint → TOKEN,
#   jwks_uri → KEYSET.
# LTI_PLATFORM_NAME=My LMS
# LTI_PLATFORM_URL=https://lms.example.com
# LTI_PLATFORM_AUTH_ENDPOINT=https://lms.example.com/lti/auth
# LTI_PLATFORM_TOKEN_ENDPOINT=https://lms.example.com/lti/token
# LTI_PLATFORM_KEYSET_URL=https://lms.example.com/lti/jwks

# -----------------------------------------------------------------------------
# Public-facing URL (REQUIRED in production)
# -----------------------------------------------------------------------------
# Your tool's public HTTPS URL — used to construct redirect URIs handed to the
# LMS. If unset, ltijs falls back to req.host which may be wrong behind a proxy.
# APP_URL=https://app.example.com

# -----------------------------------------------------------------------------
# Auth secrets (REQUIRED — your app's own JWT)
# -----------------------------------------------------------------------------
# Used by adapter.generateJwt() in the example adapters. If your project
# already has these, just reuse the same vars.
# JWT_SECRET=replace_with_long_random_string
# JWT_EXPIRES_IN=7d

# -----------------------------------------------------------------------------
# Trust / proxy
# -----------------------------------------------------------------------------
# Tell Express to trust X-Forwarded-* headers from your reverse proxy.
# Set to "1" if you're behind one (nginx, Caddy, Cloudflare, etc.)
# TRUST_PROXY=1
