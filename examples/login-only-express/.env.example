LTI_ENABLED=true
# 32+ random characters, e.g. `node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"`
LTI_ENCRYPTION_KEY=
# ltijs stores platforms, nonces, and its keypair here.
LTI_DB_URL=mongodb://localhost:27017/lti-demo
# Public HTTPS URL Moodle can reach (e.g. an ngrok/cloudflared tunnel to port 3000).
LTI_TOOL_BASE_URL=https://your-tunnel.example.com
PORT=3000
APP_JWT_SECRET=change-me

# From Moodle: Site administration > Plugins > Activity modules > External tool >
# Manage tools > (your tool) > View configuration details.
LTI_PLATFORM_URL=https://moodle.example.com
LTI_PLATFORM_CLIENT_ID=
LTI_PLATFORM_AUTH_ENDPOINT=https://moodle.example.com/mod/lti/auth.php
LTI_PLATFORM_TOKEN_ENDPOINT=https://moodle.example.com/mod/lti/token.php
LTI_PLATFORM_KEYSET_URL=https://moodle.example.com/mod/lti/certs.php
